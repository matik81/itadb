{
  "components": {
    "schemas": {
      "Observation": {
        "properties": {
          "period": {
            "format": "date",
            "title": "Period",
            "type": "string"
          },
          "release_id": {
            "format": "uuid",
            "title": "Release Id",
            "type": "string"
          },
          "scheme": {
            "title": "Scheme",
            "type": "string"
          },
          "series_code": {
            "title": "Series Code",
            "type": "string"
          },
          "status": {
            "enum": [
              "observed",
              "estimated",
              "missing",
              "suppressed",
              "demo"
            ],
            "title": "Status",
            "type": "string"
          },
          "territory_code": {
            "title": "Territory Code",
            "type": "string"
          },
          "territory_id": {
            "title": "Territory Id",
            "type": "integer"
          },
          "territory_name": {
            "title": "Territory Name",
            "type": "string"
          },
          "unit": {
            "title": "Unit",
            "type": "string"
          },
          "value": {
            "anyOf": [
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value"
          }
        },
        "required": [
          "release_id",
          "series_code",
          "unit",
          "territory_id",
          "territory_code",
          "territory_name",
          "scheme",
          "period",
          "value",
          "status"
        ],
        "title": "Observation",
        "type": "object"
      },
      "ObservationPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Observation"
            },
            "title": "Items",
            "type": "array"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          }
        },
        "required": [
          "items",
          "next_cursor"
        ],
        "title": "ObservationPage",
        "type": "object"
      },
      "Problem": {
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "title",
          "status",
          "detail",
          "request_id"
        ],
        "title": "Problem",
        "type": "object"
      },
      "Quality": {
        "properties": {
          "check_name": {
            "title": "Check Name",
            "type": "string"
          },
          "details": {
            "additionalProperties": true,
            "title": "Details",
            "type": "object"
          },
          "passed": {
            "title": "Passed",
            "type": "boolean"
          },
          "release_id": {
            "format": "uuid",
            "title": "Release Id",
            "type": "string"
          }
        },
        "required": [
          "release_id",
          "check_name",
          "passed",
          "details"
        ],
        "title": "Quality",
        "type": "object"
      },
      "Release": {
        "properties": {
          "contract_sha256": {
            "title": "Contract Sha256",
            "type": "string"
          },
          "dataset_id": {
            "title": "Dataset Id",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "is_demo": {
            "title": "Is Demo",
            "type": "boolean"
          },
          "license_url": {
            "title": "License Url",
            "type": "string"
          },
          "limitations": {
            "title": "Limitations",
            "type": "string"
          },
          "published_at": {
            "format": "date-time",
            "title": "Published At",
            "type": "string"
          },
          "raw_sha256": {
            "title": "Raw Sha256",
            "type": "string"
          },
          "reference_period": {
            "format": "date",
            "title": "Reference Period",
            "type": "string"
          },
          "retrieved_at": {
            "format": "date-time",
            "title": "Retrieved At",
            "type": "string"
          },
          "row_count": {
            "title": "Row Count",
            "type": "integer"
          },
          "source_id": {
            "title": "Source Id",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "transform_version": {
            "title": "Transform Version",
            "type": "string"
          },
          "upstream_url": {
            "title": "Upstream Url",
            "type": "string"
          }
        },
        "required": [
          "id",
          "dataset_id",
          "title",
          "limitations",
          "source_id",
          "is_demo",
          "reference_period",
          "retrieved_at",
          "published_at",
          "upstream_url",
          "raw_sha256",
          "transform_version",
          "contract_sha256",
          "license_url",
          "row_count"
        ],
        "title": "Release",
        "type": "object"
      },
      "Source": {
        "properties": {
          "homepage": {
            "title": "Homepage",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "is_demo": {
            "title": "Is Demo",
            "type": "boolean"
          },
          "license_url": {
            "title": "License Url",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "homepage",
          "license_url",
          "is_demo"
        ],
        "title": "Source",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Versioned aggregate evidence. No real-person records. Only published releases are visible. Demo data are explicitly labelled. Values are decimal strings; missing and suppressed values are null.",
    "license": {
      "identifier": "Apache-2.0",
      "name": "Apache-2.0"
    },
    "title": "Itadb Public API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
