    "/v1/observations": {
      "get": {
        "description": "Bounded keyset pagination. Keep release_id, period and series fixed across pages.\n\nPass next_cursor as after. A null next_cursor means the last page.\nUnknown series or periods return an empty page; unknown releases return 404.",
        "operationId": "observations_v1_observations_get",
        "parameters": [
          {
            "in": "query",
            "name": "release_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Release Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "period",
            "required": true,
            "schema": {
              "format": "date",
              "title": "Period",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "series",
            "required": false,
            "schema": {
              "default": "population_total",
              "pattern": "^[a-z][a-z0-9_]{0,63}$",
              "title": "Series",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "after",
            "required": false,
            "schema": {
              "default": 0,
              "maximum": 9223372036854775807,
              "minimum": 0,
              "title": "After",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 100,
              "maximum": 500,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ObservationPage"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Observations",
        "tags": [
          "statistics"
        ]
      }
    },
