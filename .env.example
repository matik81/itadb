# Local development only. Replace all passwords before any shared deployment.
POSTGRES_PASSWORD=local_dev_only
API_DB_PASSWORD=local_reader_only
ITADB_DATABASE_URL=postgresql://itadb_reader:local_reader_only@localhost:5432/itadb
ITADB_ADMIN_DATABASE_URL=postgresql://itadb:local_dev_only@localhost:5432/itadb
ITADB_DATA_DIR=data
ITADB_SERVING_BACKEND=duckdb
ITADB_SERVING_DIR=./data/serving
ITADB_DUCKDB_MEMORY_MB=256
ITADB_DUCKDB_THREADS=2
ITADB_SERVING_CONCURRENCY=4
ITADB_SERVING_TIMEOUT_SECONDS=5
ITADB_CORS_ORIGINS=["http://localhost:5173"]
